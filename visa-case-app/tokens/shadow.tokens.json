{
  "shadow": {
    "$description": "影は 3 段：0 は枠線のみ（影なし。トークンなし）、1 は浮くカード（raised）、2 はトースト・ダイアログ（overlay）。値は app/globals.css の --shadow-raised / --shadow-overlay を 1:1 で写したもの。明暗で同じ値。",
    "raised": {
      "$type": "shadow",
      "$value": [
        { "color": "rgb(0 0 0 / 0.08)", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" },
        { "color": "rgb(0 0 0 / 0.1)", "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0" }
      ]
    },
    "overlay": {
      "$type": "shadow",
      "$value": [
        { "color": "rgb(0 0 0 / 0.12)", "offsetX": "0", "offsetY": "10px", "blur": "15px", "spread": "-3px" },
        { "color": "rgb(0 0 0 / 0.1)", "offsetX": "0", "offsetY": "4px", "blur": "6px", "spread": "-4px" }
      ]
    }
  }
}
