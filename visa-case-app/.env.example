# 開発用・本番用で、別々の Supabase プロジェクトを使用してください。
# 実案件のデータを、開発環境へ入力してはいけません。
#
# 設定場所：
#   開発環境 … このファイルを .env.local としてコピーし、「開発用」プロジェクトの値を入力
#   本番環境 … Vercel の Environment Variables（Production）へ、「本番用」プロジェクトの値を登録
#
# Supabase の Project Settings > API から取得します。
# 開発時に未設定の場合は、ブラウザ内の仮データで動作します。
# 本番（next build / next start）で未設定の場合は、仮データへ切り替えず、画面を停止します。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 禁止事項：
#   - service_role キー、sb_secret_ で始まる鍵、データベースのパスワードを、この一覧へ追加しないでください。
#   - NEXT_PUBLIC_ を付けた変数は、ブラウザへ公開されます。秘密情報には使用できません。

# 郵便番号から住所の前半を入れる機能（日本郵便 郵便番号・デジタルアドレスAPI v2。Issue #226）。
# サーバー側のみで使用します（NEXT_PUBLIC_ を付けない）。値は、Vercel の Environment Variables へ登録します。
# 1つでも未設定のときは、自動入力は動かず、住所は手入力のまま使えます。
JAPANPOST_API_BASE_URL=
JAPANPOST_CLIENT_ID=
JAPANPOST_SECRET_KEY=
